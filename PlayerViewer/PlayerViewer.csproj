<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>PlayerViewer</AssemblyName>
    <RootNamespace>PlayerViewer</RootNamespace>
    <CssRoot>..\Cafe-Shader-Studio</CssRoot>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Set true to keep debug symbols and XML doc files in the publish output.
         Turn on with: dotnet publish -p:PublishDebugFiles=true -->
    <PublishDebugFiles>false</PublishDebugFiles>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\Shaders\*.vert;UI\Shaders\*.frag" />
    <EmbeddedResource Include="Effects\Gl\Shaders\*.vert;Effects\Gl\Shaders\*.frag" />
    <EmbeddedResource Include="Effects\Resources\*.bin" />
    <EmbeddedResource Include="UI\Fonts\*.otf" />
    <EmbeddedResource Include="UI\SideOrder\Resources\*.png" />
    <EmbeddedResource Include="Phive\HkTypeCatalog.json" />
  </ItemGroup>

  <!-- Test hooks and debug switches live in *.Test.cs files kept out of git. A single file
       publish, or a build with -p:NoTestCode=true, leaves them out even where they exist. -->
  <ItemGroup Condition="'$(PublishSingleFile)'=='true' Or '$(NoTestCode)'=='true'">
    <Compile Remove="**\*.Test.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <ShipWindowsNatives>true</ShipWindowsNatives>
    <ShipLinuxNatives>true</ShipLinuxNatives>
    <ShipOsxNatives>true</ShipOsxNatives>
    <TargetsWindows Condition="'$(OS)' == 'Windows_NT'">true</TargetsWindows>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <ShipWindowsNatives Condition="$(RuntimeIdentifier.StartsWith('win'))">true</ShipWindowsNatives>
    <ShipLinuxNatives Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</ShipLinuxNatives>
    <ShipOsxNatives Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</ShipOsxNatives>
    <TargetsWindows Condition="$(RuntimeIdentifier.StartsWith('win'))">true</TargetsWindows>
  </PropertyGroup>

  <!-- Opt-in automatic Tracy profiling: build with `-p:Tracy=true`. Compiles the runtime shim
       into this assembly (and pulls Tracy-CSharp so TracyClient.so ships), then a post-build step
       runs the Mono.Cecil weaver to wrap every eligible method in the output assemblies in a Tracy zone.-->
  <ItemGroup Condition="'$(Tracy)' == 'true'">
    <PackageReference Include="Tracy-CSharp" Version="0.13.1" />
    <Compile Include="..\tools\TracyWeave.cs" />
  </ItemGroup>
  <Target Name="TracyWeave" AfterTargets="Build" Condition="'$(Tracy)' == 'true'">
    <Exec Command="dotnet run --file &quot;$(MSBuildThisFileDirectory)..\tools\TracyWeaver.cs&quot; -- --dir &quot;$(TargetDir)&quot; --frame-mark PlayerViewer.UI.ViewerWindow::OnRenderFrame PlayerViewer.dll GLFrameworkEngine.dll" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Library\BfresLibrary\BfresLibrary.csproj" />
    <Reference Include="ImGui.NET">
      <HintPath>$(CssRoot)\CafeShaderStudio\Lib\ImGui.NET.dll</HintPath>
    </Reference>
    <PackageReference Include="OpenTK" Version="3.1.0" />
    <Reference Include="Syroot.Maths">
      <HintPath>$(CssRoot)\CafeShaderStudio\Lib\Syroot.Maths.dll</HintPath>
    </Reference>
    <Reference Include="Syroot.BinaryData">
      <HintPath>$(CssRoot)\CafeShaderStudio\Lib\Syroot.BinaryData.dll</HintPath>
    </Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bntx">
      <HintPath>$(CssRoot)\BfresEditor\Lib\Syroot.NintenTools.NSW.Bntx.dll</HintPath>
    </Reference>
    <ProjectReference Include="$(CssRoot)\Toolbox.Core\Toolbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Transitive runtime dep of Toolbox.Core. -->
    <PackageReference Include="SharpYaml" Version="1.6.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetsWindows)' == 'true'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CssRoot)\AGraphicsLibrary\AGraphicsLibrary.csproj" />
    <ProjectReference Include="$(CssRoot)\BfresEditor\BfresEditor.csproj" />
    <ProjectReference Include="$(CssRoot)\CafeStudio.UI\CafeStudio.UI.csproj" />
    <ProjectReference Include="$(CssRoot)\GLFrameworkEngine\GLFrameworkEngine.csproj" />
    <ProjectReference Include="..\Library\ShaderBundler\ShaderBundler.csproj" />
    <ProjectReference Include="..\Library\EffectLibrary\EffectLibrary.csproj" />
  </ItemGroup>

  <!-- Runtime content shared with Cafe Shader Studio (shaders, resources, natives). -->
  <ItemGroup>
    <Content
      Include="$(CssRoot)\CafeShaderStudio\Shaders\**\*.*"
      LinkBase="Shaders"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\Resources\**\*.*"
      LinkBase="Resources"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never"
    />
    <!-- ImGuiController loads fonts from Lib/ relative to the exe. -->
    <Content
      Include="$(CssRoot)\CafeShaderStudio\Lib\Font.ttf"
      Link="Lib\Font.ttf"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\Lib\OpenFontIcons.ttf"
      Link="Lib\OpenFontIcons.ttf"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\cimgui.dll"
      Link="cimgui.dll"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipWindowsNatives)' == 'true'"
    />
    <!-- Cross-platform ImGui natives (repo ships .so/.dylib). Copied under both the plain and
         lib-prefixed names so the .NET loader finds cimgui however it probes. -->
    <Content
      Include="$(CssRoot)\CafeShaderStudio\cimgui.so"
      Link="cimgui.so"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.so')"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\cimgui.dylib"
      Link="cimgui.dylib"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipOsxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.dylib')"
    />
    <!-- Native file dialogs (tinyfiledialogs.dll is the x64 build). -->
    <Content
      Include="$(CssRoot)\CafeShaderStudio\tinyfiledialogs.dll"
      Link="tinyfiledialogs.dll"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipWindowsNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\tinyfiledialogs.dll')"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\tinyfiledialogs.so"
      Link="tinyfiledialogs.so"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\tinyfiledialogs.so')"
    />
    <Content
      Include="$(CssRoot)\CafeShaderStudio\tinyfiledialogs.dylib"
      Link="tinyfiledialogs.dylib"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(ShipOsxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\tinyfiledialogs.dylib')"
    />
  </ItemGroup>

  <!-- Toolbox.Core's PluginManager discovers file formats by scanning <exe>/Plugins/*.dll,
       so BfresEditor (which contains the BFRES IFileFormat + IPlugin) must be copied there. -->
  <Target Name="CopyPluginDlls" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutDir)BfresEditor.dll"
      DestinationFolder="$(OutDir)Plugins"
      SkipUnchangedFiles="true"
    />
  </Target>

  <!-- Recreate the plugin scan directory in the publish output. Source BfresEditor.dll from the
       loose build output ($(OutDir)) rather than $(PublishDir): under single-file publish the DLL
       is bundled into the exe and no longer sits loose in $(PublishDir), but the pre-bundle build
       copy in $(OutDir) is always present. -->
  <Target Name="CopyPluginDllsOnPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="$(OutDir)BfresEditor.dll"
      DestinationFolder="$(PublishDir)Plugins"
      SkipUnchangedFiles="true"
      Condition="Exists('$(OutDir)BfresEditor.dll')"
    />
  </Target>

  <!-- Also drop cimgui under the lib-prefixed name in case the loader probes libcimgui.so
       (the plain-name copies above cover the other probe order). -->
  <Target Name="CopyNativeImGuiBuild" AfterTargets="Build">
    <Copy
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.so')"
      SourceFiles="$(CssRoot)\CafeShaderStudio\cimgui.so"
      DestinationFiles="$(OutDir)libcimgui.so"
      SkipUnchangedFiles="true"
    />
    <Copy
      Condition="'$(ShipOsxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.dylib')"
      SourceFiles="$(CssRoot)\CafeShaderStudio\cimgui.dylib"
      DestinationFiles="$(OutDir)libcimgui.dylib"
      SkipUnchangedFiles="true"
    />
  </Target>
  <Target Name="CopyNativeImGuiPublish" AfterTargets="Publish">
    <Copy
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.so')"
      SourceFiles="$(CssRoot)\CafeShaderStudio\cimgui.so"
      DestinationFiles="$(PublishDir)libcimgui.so"
      SkipUnchangedFiles="true"
    />
    <Copy
      Condition="'$(ShipOsxNatives)' == 'true' And Exists('$(CssRoot)\CafeShaderStudio\cimgui.dylib')"
      SourceFiles="$(CssRoot)\CafeShaderStudio\cimgui.dylib"
      DestinationFiles="$(PublishDir)libcimgui.dylib"
      SkipUnchangedFiles="true"
    />
  </Target>

  <!-- The shipped product is two executables: the viewer, and the native shader specialiser it
       drives to generate material variations. UberSlicer builds outside this repo and its two
       binaries are checked in under tools/uberslicer, one folder per platform; the build takes
       the one for its RID. The folder is a property a build can point elsewhere, and a tree
       without the binary still builds - the viewer reports that compilation is unavailable and
       existence colouring still works. UberspecRunner.FindExecutable probes these names beside
       the exe. -->
  <PropertyGroup>
    <UberSlicerDir Condition="'$(UberSlicerDir)' == ''"
      >$(MSBuildThisFileDirectory)..\tools\uberslicer\</UberSlicerDir>
  </PropertyGroup>
  <Target Name="CopyUberSlicer" AfterTargets="Build">
    <Copy
      Condition="'$(ShipWindowsNatives)' == 'true' And Exists('$(UberSlicerDir)win-x64\uberspec.exe')"
      SourceFiles="$(UberSlicerDir)win-x64\uberspec.exe"
      DestinationFiles="$(OutDir)uberslicer.exe"
      SkipUnchangedFiles="true"
    />
    <Copy
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(UberSlicerDir)linux-x64\uberspec')"
      SourceFiles="$(UberSlicerDir)linux-x64\uberspec"
      DestinationFiles="$(OutDir)uberslicer"
      SkipUnchangedFiles="true"
    />
    <Exec
      Condition="'$(ShipLinuxNatives)' == 'true' And '$(OS)' != 'Windows_NT' And Exists('$(OutDir)uberslicer')"
      Command="chmod +x &quot;$(OutDir)uberslicer&quot;"
    />
    <Warning
      Condition="'$(ShipWindowsNatives)' == 'true' And !Exists('$(UberSlicerDir)win-x64\uberspec.exe')"
      Text="No win-x64\uberspec.exe in $(UberSlicerDir); the viewer will not be able to generate shader variations."
    />
  </Target>

  <!-- Runs after bundling. The single file bundler swallows what it classifies as a native
       binary, so an exe that has to sit loose beside the published one cannot be Content. -->
  <Target Name="CopyUberSlicerPublish" AfterTargets="Publish">
    <Copy
      Condition="'$(ShipWindowsNatives)' == 'true' And Exists('$(UberSlicerDir)win-x64\uberspec.exe')"
      SourceFiles="$(UberSlicerDir)win-x64\uberspec.exe"
      DestinationFiles="$(PublishDir)uberslicer.exe"
      SkipUnchangedFiles="true"
    />
    <Copy
      Condition="'$(ShipLinuxNatives)' == 'true' And Exists('$(UberSlicerDir)linux-x64\uberspec')"
      SourceFiles="$(UberSlicerDir)linux-x64\uberspec"
      DestinationFiles="$(PublishDir)uberslicer"
      SkipUnchangedFiles="true"
    />
    <Exec
      Condition="'$(ShipLinuxNatives)' == 'true' And '$(OS)' != 'Windows_NT' And Exists('$(PublishDir)uberslicer')"
      Command="chmod +x &quot;$(PublishDir)uberslicer&quot;"
    />
  </Target>

  <!-- Runs after bundling, so the resource tree lands on disk beside the exe where the app reads
       it, whatever the bundler decided to do with the individual files. -->
  <Target Name="CopyResourcesPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishResourceFile Include="$(CssRoot)\CafeShaderStudio\Resources\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(PublishResourceFile)"
      DestinationFiles="@(PublishResourceFile->'$(PublishDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
  </Target>

  <!-- On Windows with multiple GPUs, GPU is picked by reading the NvOptimusEnablement and
       AmdPowerXpressRequestHighPerformance symbols from the executable's export table. A .NET
       apphost cannot export them at compile time, so nvpatch adds them to the built exe. Without
       this a PC/laptop with an integrated and dedicated GPU runs the viewer on the integrated GPU, which is
       stinky. We want to express preference to run on dedicated GPU, so we patch the built exe to export.

       nvpatch is vendored in tools/nvpatch so a `dotnet tool restore` is not necessary. 
       The vendored copy carries one fix: upstream sorts export names with the default comparator, 
       but the PE format wants an ordinal sort because GetProcAddress binary searches that table. 
       On singlefilehost, which had a bunch of other symbols, that left NvOptimusEnablement sorted past
       them and a single file build wouldn't properly target the dedicated GPU.

       Build with -p:NvPatch=false to skip it, which leaves the exe on the integrated GPU. -->
  <Target
    Name="EnableDiscreteGpu"
    AfterTargets="Build"
    Condition="'$(TargetsWindows)' == 'true' And '$(NvPatch)' != 'false' And Exists('$(TargetDir)$(TargetName).exe')"
  >
    <Exec
      Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\tools\nvpatch\nvpatch.csproj&quot; -c Release -- --enable &quot;$(TargetDir)$(TargetName).exe&quot;"
      ContinueOnError="WarnAndContinue"
    />
  </Target>
  <Target Name="TrimPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <!-- .NET Framework assembly binding redirects, inherited from the vendored projects.
           .NET Core resolves through deps.json and never reads these. Verified by removing them:
           the app starts and loads models exactly as before. -->
      <PublishJunk Include="$(PublishDir)*.dll.config" />
      <PublishJunk Include="$(PublishDir)*.pdb" Condition="'$(PublishDebugFiles)' != 'true'" />
      <PublishJunk Include="$(PublishDir)*.xml" Condition="'$(PublishDebugFiles)' != 'true'" />
    </ItemGroup>
    <Delete Files="@(PublishJunk)" />
  </Target>

  <Target
    Name="EnableDiscreteGpuPublish"
    AfterTargets="Publish"
    Condition="'$(TargetsWindows)' == 'true' And '$(NvPatch)' != 'false'"
  >
    <Exec
      Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\tools\nvpatch\nvpatch.csproj&quot; -c Release -- --enable &quot;$(PublishDir)$(TargetName).exe&quot;"
      ContinueOnError="WarnAndContinue"
    />
  </Target>
</Project>
